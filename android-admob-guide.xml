<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.vercel.edubot247.twa">

    <!-- Quyền cần thiết cho mạng và Google Mobile Ads SDK -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="EduBot 247"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EduBot247">

        <!-- Google AdMob Application ID (Bắt buộc cho SDK) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5320880447374751~3167851635"/>

        <!-- 1. SplashActivity: Màn hình chờ hiển thị Quảng cáo Mở ứng dụng (Ads 2: ca-app-pub-5320880447374751/7345879147) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.EduBot247.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. LauncherActivity: Mở trang Web TWA chính chủ edubot247.vercel.app -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://edubot247.vercel.app" />
        </activity>

    </application>
</manifest>
